# WireGuard config for the on-prem RELAY box (the only component with any
# inbound-facing surface -- see the architecture diagram in issue #55).
#
# Plain pinned-key WireGuard, direct connection -- no Headscale/Tailscale,
# no rendezvous-hop variant. The relay's network has a port-forwarded
# WireGuard port, so peers dial it directly.
#
# Fill in the placeholders below, then: sudo cp relay.conf /etc/wireguard/wg0.conf
# && sudo systemctl enable --now wg-quick@wg0

[Interface]
# relay.privatekey, generated by generate_keys.py (or `wg genkey`). Never
# share this value or commit it -- only the matching .publickey is shared.
PrivateKey = <RELAY_PRIVATE_KEY>
Address = 10.55.0.1/24
# UDP port that is forwarded from the relay's public IP -- the one inbound
# surface this whole design allows.
ListenPort = 51820

# One [Peer] block per device that is allowed to reach the relay: the Mac
# running the daemon, and each paired phone. Add/remove blocks as devices
# are paired/revoked (Phase 2 automates this; Phase 0 is hand-edited).

[Peer]
# mac-daemon.publickey
PublicKey = <MAC_DAEMON_PUBLIC_KEY>
AllowedIPs = 10.55.0.2/32

[Peer]
# phone-1.publickey
PublicKey = <PHONE_PUBLIC_KEY>
AllowedIPs = 10.55.0.3/32
