# PrivacyFence configuration example.
# Copy this file to config/settings.yaml and adjust as needed.
#
# This file is USER-level only — privacy policy, which connectors are
# enabled, and auto-accept rules. It carries no secrets:
#
#   - Organization-level app credentials (the Google OAuth client, Slack app,
#     Telegram app, Salesforce Connected App, Atlassian OAuth app) are
#     installed as one bundle via "Install/Update Organization Config…" in
#     the PrivacyFence menu bar. IT admins build that bundle once with
#     scripts/build_org_bundle.py and distribute it.
#   - Per-user sign-in (browser OAuth, or Telegram's phone + code login) is
#     done via "Authenticate…" per connector, also in the menu bar.
#
# Never commit config/settings.yaml or any file under credentials/.

# All six category-schema groups below (privacy / drive_privacy /
# slack_privacy / contacts_privacy / tasks_privacy / confluence_privacy) are
# also editable live from the menu bar's "Privacy Filter…" window (no
# restart needed) -- editing them here or from the menu are equivalent.
privacy:
  # Policy applied when a category is not explicitly configured below.
  # One of: allow, redact, block
  default_policy: block

  # Per-category filtering applied BEFORE the user sees the data in the review UI.
  # The privacy filter is a floor (a minimum protection), not a ceiling -
  # the user still has to approve every request.
  #   allow  -> data passes through unchanged
  #   redact -> data is replaced by a placeholder revealing only its length
  #             (e.g. "[REDACTED BY PRIVACY FILTER — 42 characters withheld]") -
  #             a full replacement, not a partial reveal of the content;
  #             for list-shaped categories this behaves the same as block
  #   block  -> data is replaced with "[BLOCKED BY PRIVACY FILTER]"
  categories:
    body: allow
    metadata: allow        # sender / recipients / date / subject
    attachments: block     # attachment metadata; downloading content is a separate, approval-gated tool
    thread_history: allow

drive_privacy:
  # Also covers Google Sheets (drive_sheets_* tools) - Sheets is not a
  # separate connector, it rides on the Drive connector's OAuth grant.
  default_policy: block
  categories:
    file_content: allow      # the actual document text / bytes (highest risk)
    file_metadata: allow     # name / owners / created/modified times / sharing
    file_list: allow         # results from list operations (names + ids)
    folder_structure: allow  # folder listing results
  # NOTE: file_metadata and file_list cover overlapping fields (a file's name/
  # owners) but gate two different tools (drive_get_file_metadata vs.
  # drive_list_files) independently - restricting one without the other
  # still lets that same information through the tool whose category is
  # still "allow". PrivacyFence logs a startup warning if they're set
  # inconsistently (privacy_filter.check_consistency_warnings).

slack_privacy:
  default_policy: block
  categories:
    message_content: allow   # the text of messages
    user_identity: allow     # user names, emails, real names
    channel_list: allow      # channel names and metadata
    thread_content: allow    # thread reply content
    dm_list: allow           # 1:1 DM listing (who you DM with)
    group_chat_list: allow   # group-DM listing (id, name, participants)

contacts_privacy:
  default_policy: block
  categories:
    notes: block   # free-text biography field - the one field here that can
                   # carry arbitrary personal content, unlike name/email/
                   # phone/organization/job_title, which have no category of
                   # their own and always pass through unfiltered

tasks_privacy:
  default_policy: block
  categories:
    notes: block   # free-text notes field - same reasoning as
                   # contacts_privacy.notes; title/due/status have no
                   # category of their own

confluence_privacy:
  default_policy: block
  categories:
    search_excerpt: block   # the content excerpt confluence_search/
                            # confluence_cql_search return alongside each
                            # match - the one place Confluence's otherwise
                            # metadata-only auto search tools return actual
                            # page content pre-approval
    attachments: block      # attachment metadata; downloading content is a separate, approval-gated tool

calendar:
  # Whether calendar_get_free_busy returns full event titles/times/status for
  # a queried colleague when the authenticated account already has calendar
  # access to see them (falls back to busy/free-only automatically when
  # access isn't available either way). Set to false to always return
  # busy/free blocks only, regardless of access - a more conservative choice
  # for scheduling queries across a team, at the cost of losing event
  # titles/status in the (auto-approved) free/busy result.
  free_busy_full_event_details: true

# Enable/disable individual connectors (all enabled by default — this section
# is only needed to turn one off). Toggled automatically when you use
# Disable/Enable in the menu bar. Enabling here isn't enough on its own: a
# connector also needs its organization config installed AND to be
# authenticated (both from the menu bar) before it actually runs.
# connectors:
#   telegram: { enabled: false }

pii_detection:
  # Extra confirmation gate, on top of the normal Allow once/Deny popup:
  # scans the message/document/spreadsheet content shown in the approval
  # popup for likely personal data (Hungarian, English, and German — IBANs,
  # credit card numbers, national ID/tax/social-security numbers, and
  # similar; email addresses and phone numbers are deliberately not
  # detected, see docs/TECHNICAL_REFERENCE.md). When something is flagged,
  # the popup is tinted red and a second "Are you sure?" dialog is required
  # before Allow once (or Always allow) takes effect. Toggled automatically
  # when you use "PII Detection Gate" in the menu bar.
  enabled: true

  # IP addresses and currency figures show up constantly in ordinary
  # business correspondence (server logs, invoices, budgets) without being
  # personal data about anyone, so these two categories can be turned off
  # independently of the gate as a whole. Toggled automatically from the
  # "PII Detection Gate" submenu in the menu bar.
  detect_ip_addresses: true
  detect_financial_figures: true

  # PII-refinement trial capture -- OFF by default, and not meant to stay on
  # indefinitely. When true, the audit log's "PII Match Details" column also
  # records the literal matched text (redacted for value-bearing categories
  # like IBAN/credit card/national IDs -- see docs/TECHNICAL_REFERENCE.md's
  # "PII detection gate" section) for a request that was actually approved,
  # or a fixed "details hidden" placeholder for one that was denied. There's
  # no menu-bar toggle for this one deliberately -- set it for a bounded
  # trial window (restart required to pick it up), review the weekly Excel
  # export's "By PII category" breakdown to see which patterns are noisy,
  # then turn it back off.
  audit_match_details: false

update_check:
  # Once-a-day background check against GitHub Releases
  # (https://github.com/andras-tkcs/privacyfence/releases) for a newer version. Never downloads
  # or installs anything automatically -- only shows a menu item / one-time dialog with a link to
  # the release page. A network failure here is silent (logged, not shown) and never blocks
  # startup. Toggled automatically when you use "Check for Updates" > "Enabled" in the menu bar.
  enabled: true

  # Off by default. When on, the daily check also considers pre-release (beta/rc) tags, not just
  # the latest stable release -- opt in here if you're a beta tester. Toggled automatically when
  # you use "Check for Updates" > "Receive Beta Releases" in the menu bar.
  include_beta: false

# Note: unattended_sessions.enabled (privacyfence_begin_unattended_session's
# opt-in gate) is NOT set here. It's a deliberate per-organization choice,
# not a per-user setting, so it lives in the organization config bundle
# (org_config.json, installed via "Install/Update Organization Config…" in
# the menu bar) — see docs/TECHNICAL_REFERENCE.md's "Scheduled / unattended
# Cowork tasks" section.

# Trust a specific resource once — a folder, a task list, a channel, ... —
# instead of adding the same ID to several operation keys under
# auto_accept_rules below. Each entry is grouped by connector and resource
# type, with a small set of capability booleans (read / write / create /
# ...) that decide which operations it actually auto-accepts; every new
# grant starts with every capability off, so adding one does nothing until
# you explicitly flip a capability on. This is also the section the menu
# bar's "Auto-accept Rules → <Connector> → Trusted <Resource>" submenus
# read and write — editing it here or from the menu are equivalent, and
# ``name`` is a cosmetic label (last resolved from the connector, shown in
# the menu) that the evaluator itself never reads. See "Auto-accept grants"
# in docs/TECHNICAL_REFERENCE.md for the full per-connector reference.
# auto_accept_grants:
#   drive:
#     sandbox_folders:
#       # A folder Claude can write into without a popup each time (e.g. a
#       # scratch space you created for it) — also covers Sheets/Docs writes
#       # (write_range/add_sheet/rename_sheet/format_range/insert_dimensions/
#       # delete_dimensions/docs.edit_content/docs.format_content) in that
#       # folder.
#       - id: "<drive folder id>"
#         name: "Claude scratch space"
#         write: true
#     folders:
#       # A folder Claude can read from without a popup (does NOT also grant
#       # write — that's the separate "sandbox_folders" list above).
#       - id: "<drive folder id>"
#         name: "Shared Reports"
#         read: true
#   tasks:
#     task_lists:
#       - id: "<task list id>"
#         name: "Personal"
#         create: true
#         edit: true
#         complete: true
#         move: true

auto_accept_rules:
  contacts.edit:
    # Auto-accept contact edits that don't touch emails/phones (name,
    # organization, or notes-only changes)
    - rule: no_contact_info_change
  # sheets.write_range:
    # Auto-accept writes to spreadsheets created earlier in the same session
    # (e.g. filling in a sheet PrivacyFence just created for you)
    # - rule: created_this_session
  # gmail.create_label:
    # Auto-accept creating labels whose name is in the allowlist (nested
    # names match on the full "Parent/Child" string)
    # - rule: label_name_allowlist
    #   value: ["Receipts", "Travel/Bookings"]
  # Trusting a specific folder, task list, channel, project, space, chat,
  # calendar, or Salesforce report? Use auto_accept_grants
  # above instead — it's the same underlying mechanism (this is what it
  # compiles down to) but configured once per resource instead of once per
  # operation key.

logging:
  # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: INFO
  # Log file path. Relative paths are resolved against the project root.
  file: logs/privacyfence.log

web:
  # Which ApprovalUI shows the approval popup -- "native" (today's macOS
  # AppKit/WKWebView dialog, unchanged) or "web" (the same card, served
  # over local HTTP and opened in a browser instead -- see
  # docs/https-connector-refactor-plan.md's P1). This is the rollback lever
  # for the whole web approval surface: flipping it back to "native" turns
  # the embedded HTTP server off entirely and returns to today's behavior,
  # no downgrade needed. Default "native" -- the web surface ships opt-in.
  approval_ui: native
  # Port the embedded HTTP server listens on -- shared by the approval
  # surface above and the /mcp endpoint below, one server either way. Always
  # bound to localhost only in this (local) mode -- see web/server.py's
  # module docstring.
  port: 8765
  mcp:
    # Turns on the /mcp Streamable HTTP endpoint (see
    # docs/https-connector-refactor-plan.md's P2) -- Claude talks to
    # PrivacyFence directly over HTTP instead of through the
    # privacyfence-bridge Node process. Independent of approval_ui above:
    # a gated call reaching a connector over /mcp still shows whichever
    # popup (native or web) approval_ui selects. The bridge keeps working
    # unchanged either way -- this is additive, not a replacement, until P5
    # retires it. Loopback-only and bearer-token-gated regardless (§10 of
    # the refactor plan), same trust posture as the bridge's own IPC socket
    # had. On by default as of D11/P4b: PrivacyFence.mcpb now installs a
    # thin stdio shim for Claude Desktop that only speaks /mcp, so a fresh
    # install needs this on for that extension's zero-config promise ("no
    # config file edited") to actually hold -- see §12's P4b exit
    # criterion. Flip to false to go back to bridge-only, or if you'd
    # rather this daemon never bind a second listener at all. Once enabled,
    # point a Streamable HTTP MCP client at http://localhost:<port>/mcp
    # with `Authorization: Bearer <the token in ~/.privacyfence/mcp_token>`.
    enabled: true
  settings:
    # Serve /settings and its POST /api/settings/{action} dispatcher (see
    # docs/https-connector-refactor-plan.md §16) -- independent of
    # approval_ui above: a user can run the web settings page with the
    # native approval dialog, or the reverse. Rollback lever for this
    # surface specifically: flipping back to false returns to the native
    # settings window only, which this phase leaves fully working
    # (P10 is what eventually retires it). Default false -- opt-in, same
    # posture as approval_ui.
    enabled: false
    # rumps.quit_application() from a browser stops the server rendering
    # the page it was clicked on -- confirmed in-page either way (§16.2.8),
    # but this is the local-mode-only kill switch for the action entirely.
    # Will be refused outright once `mode: org` exists (a future phase);
    # local mode leans "the token is enough" (§16.8's open question #2).
    allow_quit: true
  notifications:
    # Desktop notifications for a new pending approval while the
    # /approvals tab is open but not focused (docs/approval-list-ui-ux.md
    # §4) -- tiers 0 (title badge, aria-live announcement) and 1
    # (registration.showNotification(), no push service involved, nothing
    # leaves the machine) only. Body is always the bare pending count
    # ("N approvals pending") regardless of `detail` below -- the richer
    # `standard`/`detailed` levels this key is reserved for need a real
    # per-field allowlist (never the row's own title/summary, which can
    # carry real gated content) that hasn't been built yet; see
    # web_shell.py's own module docstring. Tier 2 (web push, a closed tab,
    # a phone) is org mode/P7+ work and has no key here yet.
    enabled: true
    detail: standard # minimal | standard | detailed -- reserved, see above
