<?xml version="1.0" encoding="UTF-8"?>
<!--
PrivacyFence autostart Task Scheduler task definition (Phase 3.1, revised).

installer/privacyfence.iss's [Code] section extracts this template at
install time, substitutes __EXEC_PATH__ with the real installed
"{app}\{#AliasExeName}" path, and registers it via
`schtasks /create /tn "PrivacyFence" /xml <file> /f`.

Structure follows Microsoft's own official "any group member" logon
trigger example (learn.microsoft.com/en-us/windows/win32/taskschd/
logon-trigger-example xml): LogonTrigger with no UserId fires for any
interactive logon, not just one specific account, and Principal uses
GroupId (the built-in Users group) rather than UserId so the task runs
as whichever user just logged on, in their own session: the same
"whichever account is at the keyboard" scope the macOS LaunchAgent and
the Linux .deb's XDG autostart already have. MultipleInstancesPolicy is
Parallel, not the more common IgnoreNew, deliberately: this task can
legitimately have more than one concurrent instance at once, one per
user session, since GroupId, unlike a single UserId, can trigger for
several different logged on users at the same time.

RestartOnFailure is the piece plain schtasks /create CLI flags never
had a way to express at all; there is no equivalent flag, see
installer/privacyfence.iss's own comment history. It is the direct
analogue of the macOS LaunchAgent's KeepAlive/SuccessfulExit=false and
the Linux .deb plan's own systemd Restart=on-failure.

NOTE: this comment intentionally avoids the two-hyphen sequence, which
XML comments may not contain anywhere in their body.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Starts PrivacyFence when any user signs in, and restarts it if it exits unexpectedly.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal>
      <GroupId>BUILTIN\Users</GroupId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>Parallel</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions>
    <Exec>
      <Command>__EXEC_PATH__</Command>
    </Exec>
  </Actions>
</Task>
