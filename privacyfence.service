# PrivacyFence daemon systemd --user unit — Linux equivalent of
# com.privacyfence.app.plist, for a real (non-editable) `pip`/`pipx install
# privacyfence` (see CLAUDE.md's "Publishing to PyPI" section for how the
# package gets onto PyPI in the first place).
#
# ================================================================
# The specific blocker this comment used to describe -- `daemon_main.
# run_app()` unconditionally ending with `from .menu_bar import
# run_menu_bar; run_menu_bar(...)`, and `menu_bar.py` doing a bare `import
# rumps` (macOS AppKit) at module scope with no platform guard -- is fixed
# as of P10 (docs/https-connector-refactor-plan.md §12, decision D6):
# menu_bar.py and the rest of the native AppKit UI layer are deleted
# outright, not merely guarded, and run_app() now ends by blocking on a
# plain threading.Event (see that module's own `_wait_for_shutdown`).
# `rumps`/`pyobjc-framework-*` are optional extras now (pyproject.toml's
# `macos-native` group) that this install path never pulls in.
#
# UNVERIFIED ON A REAL LINUX INSTALL, still. Nothing in src/privacyfence/
# imports a platform-specific module any more (grep for `sys.platform`/
# `darwin` turns up nothing outside this comment and its own history), and
# the daemon starts and runs headlessly in this repo's own Linux CI leg
# (`.github/workflows/tests.yml`) as of P10 -- but that only exercises the
# unit test suite, not this systemd unit, a real `pipx install privacyfence`,
# or a live connector's OAuth flow (`webbrowser.open()`-based, which is
# cross-platform, but genuinely untested end to end on Linux). Treat this
# unit as ready to try, not yet a supported install path -- see #121 in the
# issue tracker for the umbrella Linux/Windows tracking issue, revisited
# per D8 (§15) now that this refactoring is complete.
# ================================================================
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp privacyfence.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now privacyfence
#
# Uninstall:
#   systemctl --user disable --now privacyfence
#   rm ~/.config/systemd/user/privacyfence.service
#   systemctl --user daemon-reload
#
# Logs: journalctl --user -u privacyfence -f
#
# ExecStart assumes `pipx install privacyfence` (pipx's default bin
# location). Adjust if installed elsewhere (a plain `pip install --user`,
# or a dedicated venv).

[Unit]
Description=PrivacyFence daemon
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/privacyfence-app
# Mirrors the plist's KeepAlive/SuccessfulExit=false: restart on a crash,
# not on a clean exit (e.g. `systemctl --user stop`).
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
